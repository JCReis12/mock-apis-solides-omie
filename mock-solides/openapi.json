{
  "openapi": "3.0.2",
  "info": {
    "title": "Inovanet - Sólides RH & Ecossistema People (Mock API)",
    "description": "API de simulação da Sólides (RH) e conectores do ecossistema People (SulAmérica, Wellhub, Flash Benefícios, Vixting, Porto Seguro e Alura/Senai) para o projeto Inovanet com Gemini Enterprise.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Servidor da API Mock Sólides (Render / Local)"
    }
  ],
  "paths": {
    "/solides/colaboradores": {
      "get": {
        "tags": [
          "Sólides (RH)"
        ],
        "summary": "Listar ou buscar colaboradores por nome ou departamento",
        "description": "Permite ao agente buscar colaboradores pelo nome ou listar todos os cadastros disponíveis para descobrir IDs e CPFs.",
        "operationId": "listar_colaboradores_solides",
        "parameters": [
          {
            "name": "nome",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtro parcial por nome do colaborador (ex: 'Mariana', 'Beatriz')",
              "title": "Nome"
            },
            "description": "Filtro parcial por nome do colaborador (ex: 'Mariana', 'Beatriz')"
          },
          {
            "name": "departamento",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtro por departamento (ex: 'Tecnologia', 'Comercial')",
              "title": "Departamento"
            },
            "description": "Filtro por departamento (ex: 'Tecnologia', 'Comercial')"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ColaboradorResumo"
                  },
                  "title": "Response Listar Colaboradores Solides"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/solides/colaboradores/{colaborador_id}": {
      "get": {
        "tags": [
          "Sólides (RH)"
        ],
        "summary": "Consultar dados cadastrais, salário base e benefícios fixos do colaborador",
        "description": "Retorna dados de RH, salário base, benefícios fixos e CPF da Sólides a partir do ID (ex: 101, 102, 103, 104).",
        "operationId": "consultar_colaborador_solides",
        "parameters": [
          {
            "name": "colaborador_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "ID interno do colaborador na Sólides (ex: 101, 102, 103, 104)",
              "title": "Colaborador Id"
            },
            "description": "ID interno do colaborador na Sólides (ex: 101, 102, 103, 104)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ColaboradorSolidesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/solides/colaboradores/{colaborador_id}/beneficios-detalhados": {
      "get": {
        "tags": [
          "Sólides (RH)"
        ],
        "summary": "Consultar detalhamento das integrações People (SulAmérica, Wellhub, Vixting, Porto Seguro, Alura)",
        "description": "Retorna status e planos detalhados dos benefícios e fornecedores de RH vinculados ao colaborador.",
        "operationId": "consultar_beneficios_detalhados_people",
        "parameters": [
          {
            "name": "colaborador_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "ID interno do colaborador na Sólides (ex: 101, 102, 103, 104)",
              "title": "Colaborador Id"
            },
            "description": "ID interno do colaborador na Sólides (ex: 101, 102, 103, 104)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegracoesPeopleResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/solides/integracoes/status": {
      "get": {
        "tags": [
          "Observabilidade & Conectores"
        ],
        "summary": "Consultar telemetria e integridade dos conectores do ecossistema (Sólides, Flash, Onfly, etc.)",
        "description": "Retorna disponibilidade, latência p95, taxa de erro e saúde de todos os nós e fornecedores mapeados no projeto.",
        "operationId": "consultar_status_integracoes_people",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOverviewResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BeneficiosFixos": {
        "properties": {
          "vale_refeicao_alimentacao": {
            "type": "number",
            "title": "Vale Refeicao Alimentacao",
            "description": "Valor mensal de VR/VA em R$"
          },
          "plano_saude_sulamerica": {
            "type": "number",
            "title": "Plano Saude Sulamerica",
            "description": "Custo mensal do plano de saúde SulAmérica em R$"
          },
          "wellhub_gympass": {
            "type": "number",
            "title": "Wellhub Gympass",
            "description": "Custo mensal do benefício Wellhub em R$"
          },
          "auxilio_home_office": {
            "type": "number",
            "title": "Auxilio Home Office",
            "description": "Auxílio mensal de home office em R$"
          }
        },
        "type": "object",
        "required": [
          "vale_refeicao_alimentacao",
          "plano_saude_sulamerica",
          "wellhub_gympass",
          "auxilio_home_office"
        ],
        "title": "BeneficiosFixos"
      },
      "ColaboradorResumo": {
        "properties": {
          "colaborador_id": {
            "type": "integer",
            "title": "Colaborador Id",
            "description": "ID único do colaborador na Sólides"
          },
          "nome": {
            "type": "string",
            "title": "Nome",
            "description": "Nome completo"
          },
          "cargo": {
            "type": "string",
            "title": "Cargo",
            "description": "Cargo atual"
          },
          "departamento": {
            "type": "string",
            "title": "Departamento",
            "description": "Departamento/Área"
          },
          "colaborador_cpf": {
            "type": "string",
            "title": "Colaborador Cpf",
            "description": "CPF do colaborador"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Status do contrato"
          }
        },
        "type": "object",
        "required": [
          "colaborador_id",
          "nome",
          "cargo",
          "departamento",
          "colaborador_cpf",
          "status"
        ],
        "title": "ColaboradorResumo"
      },
      "ColaboradorSolidesResponse": {
        "properties": {
          "fonte": {
            "type": "string",
            "title": "Fonte",
            "description": "Sistema de origem do registro",
            "default": "Sólides RH (Mock)"
          },
          "colaborador_id": {
            "type": "integer",
            "title": "Colaborador Id",
            "description": "ID único do colaborador na Sólides"
          },
          "nome": {
            "type": "string",
            "title": "Nome",
            "description": "Nome completo do colaborador"
          },
          "colaborador_cpf": {
            "type": "string",
            "title": "Colaborador Cpf",
            "description": "CPF do colaborador (chave de cruzamento com o Omie)"
          },
          "cargo": {
            "type": "string",
            "title": "Cargo",
            "description": "Cargo atual"
          },
          "departamento": {
            "type": "string",
            "title": "Departamento",
            "description": "Área/Departamento de alocação"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Status contratual do colaborador"
          },
          "data_admissao": {
            "type": "string",
            "title": "Data Admissao",
            "description": "Data de admissão (YYYY-MM-DD)"
          },
          "salario_base": {
            "type": "number",
            "title": "Salario Base",
            "description": "Salário bruto base mensal em R$"
          },
          "beneficios_fixos": {
            "$ref": "#/components/schemas/BeneficiosFixos"
          },
          "total_beneficios_fixos": {
            "type": "number",
            "title": "Total Beneficios Fixos",
            "description": "Soma dos benefícios fixos mensais em R$"
          }
        },
        "type": "object",
        "required": [
          "colaborador_id",
          "nome",
          "colaborador_cpf",
          "cargo",
          "departamento",
          "status",
          "data_admissao",
          "salario_base",
          "beneficios_fixos",
          "total_beneficios_fixos"
        ],
        "title": "ColaboradorSolidesResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOverviewResponse": {
        "properties": {
          "businessPeriod": {
            "type": "string",
            "title": "Businessperiod",
            "description": "Período de referência (YYYY-MM)"
          },
          "totalSistemas": {
            "type": "integer",
            "title": "Totalsistemas",
            "description": "Total de sistemas monitorados"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/HealthStatusItem"
            },
            "type": "array",
            "title": "Observations",
            "description": "Status e indicadores de cada conector"
          }
        },
        "type": "object",
        "required": [
          "businessPeriod",
          "totalSistemas",
          "observations"
        ],
        "title": "HealthOverviewResponse"
      },
      "HealthStatusItem": {
        "properties": {
          "systemId": {
            "type": "string",
            "title": "Systemid",
            "description": "Identificador do sistema integrado"
          },
          "health": {
            "type": "string",
            "title": "Health",
            "description": "Saúde operacional (available, degraded, maintenance, unavailable, unknown)"
          },
          "integrationState": {
            "type": "string",
            "title": "Integrationstate",
            "description": "Estado da integração (enabled, paused, not_configured)"
          },
          "metrics": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metrics",
            "description": "Métricas de disponibilidade e latência"
          }
        },
        "type": "object",
        "required": [
          "systemId",
          "health",
          "integrationState"
        ],
        "title": "HealthStatusItem"
      },
      "IntegracoesPeopleResponse": {
        "properties": {
          "colaborador_id": {
            "type": "integer",
            "title": "Colaborador Id",
            "description": "ID do colaborador"
          },
          "nome": {
            "type": "string",
            "title": "Nome",
            "description": "Nome do colaborador"
          },
          "integracoes_people": {
            "additionalProperties": true,
            "type": "object",
            "title": "Integracoes People",
            "description": "Detalhamento em SulAmérica, Wellhub, Porto Seguro, Flash, Vixting e Alura"
          }
        },
        "type": "object",
        "required": [
          "colaborador_id",
          "nome",
          "integracoes_people"
        ],
        "title": "IntegracoesPeopleResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}